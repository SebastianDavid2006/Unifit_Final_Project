generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Rol {
  admin
  entrenador
  usuario
}

enum TipoUsuario {
  estudiante
  profesor
  administrativo
}

enum EstadoUsuario {
  pendiente
  activo
  inactivo
}

enum TipoDocumento {
  CC //Cédula de ciudadanía
  TI //Tarjeta de identidad
  CE //Cédula de extranjería
  PA //Pasaporte
  RC //Registro cívil
}

enum NivelPrograma {
  especializacion
  tecnico
  profesional
}

enum Universidad {
  uni_colombia // Universitaria de Colombia
  uni_bogota // Universitaria de Bogotá
}

enum EstadoAgenda {
  pendiente
  completado
  cancelado
  no_asistio
}

enum TipoAgenda {
  valoracion
  registro
  seguimiento
  otro
}

enum ModalidadEstudiante {
  presencial
  virtual
}

enum JornadaEstudiante {
  diurna
  nocturna
  finde
}

enum EstadoRutina {
  activa
  finalizada
  cancelada
}

enum EstadoMaquina {
  disponible
  mantenimiento
  sin_servicio
}

enum NivelExperiencia {
  principiante
  intermedio
  avanzado
}

enum NivelActividad {
  sedentario
  ligero
  moderado
  activo
  muy_activo
}

enum EstadoDocumento {
  vigente
  obsoleto
  vencido
}

enum EstadoSesionRutina {
  en_progreso
  finalizada
  cancelada
}

enum ObjetivoUsuario {
  perdida_peso
  ganancia_muscular
  acondicionamiento_fisico
  salud
  rendimiento_deportivo
  otro
}

enum TipoAntecedente {
  osteomuscular
  respiratorio
  psiquiatrico
  cardiovascular
  metabolico
  psicologico
}

enum RutinaDuracion {
  cuatro_semanas
  ocho_semanas
  doce_semanas
  dieciseis_semanas
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
}

enum TipoDocLegal {
  contrato_gym
  tratamiento_datos
}

enum GrupoMuscular {
  pecho
  espalda
  hombros
  brazos
  piernas
  abdomen_core
  cardio
  general
  tren_superior
  tren_inferior
}

enum Genero {
  masculino
  femenino
  otro
}

enum GrupoSanguineo {
  a_positivo
  a_negativo
  b_positivo
  b_negativo
  ab_positivo
  ab_negativo
  o_positivo
  o_negativo
}

enum Parentesco {
  padre
  madre
  hermano_a
  abuelo_a
  tio_a
  primo_a
  otro
}

// USUARIO

model Usuario {
  id_usuario            String          @id @default(uuid())
  primer_nombre         String
  segundo_nombre        String?
  primer_apellido       String
  segundo_apellido      String?
  email_contacto        String          @unique
  telefono_contacto     String?
  documento             String          @unique
  tipo_documento        TipoDocumento   @default(CC)
  fecha_nacimiento      DateTime?
  genero                Genero
  genero_otro           String?
  rol                   Rol             @default(usuario)
  tipo_usuario          TipoUsuario     @default(estudiante)
  estado                EstadoUsuario   @default(pendiente)
  password_hash         String?
  debe_cambiar_password Boolean         @default(true) //primer login  
  eps                   String?
  eps_certificado       String?
  grupo_sanguineo       GrupoSanguineo?
  nombre_emergencia     String?
  telefono_emergencia   String?
  parentesco_emergencia Parentesco?
  parentesco_otro       String?
  fecha_creacion        DateTime        @default(now())
  fecha_modificacion    DateTime        @updatedAt
  parq_realizado        Boolean         @default(false)
  fecha_parq            DateTime?

  estudiante     Estudiante?
  profesor       Profesor?
  administrativo Administrativo?
  acudiente_de   Acudiente? // si este usuario es menor, su acudiente

  huella               Huella?
  valoraciones_creadas Valoracion[]          @relation("ValoracionCreador")
  valoraciones         Valoracion[]          @relation("ValoracionUsuario")
  rutinas_creadas      Rutina[]              @relation("RutinaCreador")
  rutinas              Rutina[]              @relation("RutinaUsuario")
  asistencias          Asistencia[]
  agenda_usuario       Agenda[]              @relation("AgendaUsuario")
  agenda_creada        Agenda[]              @relation("AgendaCreador")
  cupos_creados        Cupo[]
  aceptaciones         AceptacionDocumento[] @relation("AceptacionUsuario")
  aceptaciones_creadas AceptacionDocumento[] @relation("AceptacionActivador")
  ejercicios_creados   Ejercicio[]
  maquinas_creadas     Maquina[]
}

// Tipos de Usuario

model Estudiante {
  id_estudiante  String               @id @default(uuid())
  id_usuario     String               @unique
  id_programa    String
  numero_carnet  String?              @unique
  semestre       Int?
  modalidad      ModalidadEstudiante?
  jornada        JornadaEstudiante?
  es_egresado    Boolean              @default(false)
  fecha_creacion DateTime             @default(now())

  usuario  Usuario  @relation(fields: [id_usuario], references: [id_usuario])
  programa Programa @relation(fields: [id_programa], references: [id_programa])
}

model Profesor {
  id_profesor    String   @id @default(uuid())
  id_usuario     String   @unique
  id_cargo       String
  id_area        String
  fecha_creacion DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
  cargo   Cargo   @relation(fields: [id_cargo], references: [id_cargo])
  area    Area    @relation(fields: [id_area], references: [id_area])
}

model Administrativo {
  id_administrativo String   @id @default(uuid())
  id_usuario        String   @unique
  id_cargo          String
  id_area           String
  fecha_creacion    DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
  cargo   Cargo   @relation(fields: [id_cargo], references: [id_cargo])
  area    Area    @relation(fields: [id_area], references: [id_area])
}

// ACUDIENTE (para usuarios menores de edad)

model Acudiente {
  id_acudiente       String        @id @default(uuid())
  id_usuario_acudido String        @unique
  primer_nombre      String
  segundo_nombre     String?
  primer_apellido    String
  segundo_apellido   String?
  documento          String        @unique
  tipo_documento     TipoDocumento @default(CC)
  telefono_contacto  String?
  fecha_creacion     DateTime      @default(now())
  fecha_modificacion DateTime      @updatedAt

  usuario_acudido Usuario @relation(fields: [id_usuario_acudido], references: [id_usuario])
}

// CONFIG UNIVERSIDAD

model Programa {
  id_programa        String        @id @default(uuid())
  nombre             String
  universidad        Universidad
  tipo_programa      NivelPrograma
  activo             Boolean       @default(true)
  fecha_creacion     DateTime      @default(now())
  fecha_modificacion DateTime      @updatedAt

  estudiantes Estudiante[]

  @@unique([nombre, universidad])
}

model Cargo {
  id_cargo       String   @id @default(uuid())
  nombre         String   @unique
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  profesores      Profesor[]
  administrativos Administrativo[]
}

model Area {
  id_area        String   @id @default(uuid())
  nombre         String   @unique
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  profesores      Profesor[]
  administrativos Administrativo[]
}

// BIOMETRIA

model Huella {
  id_huella      String   @id @default(uuid())
  id_usuario     String   @unique
  id_sensor      Int      @unique
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
}

// ASISTENCIA

model Asistencia {
  id_asistencia    String    @id @default(uuid())
  id_usuario       String
  fecha            DateTime  @default(now())
  hora_ingreso     DateTime
  hora_salida      DateTime?
  duracion_minutos Int?
  observaciones    String?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
}

// VALORACIÓN

model Valoracion {
  id_valoracion              String            @id @default(uuid())
  id_usuario                 String
  id_creador                 String
  fecha                      DateTime          @default(now())
  proxima_valoracion         DateTime?
  objetivos                  ObjetivoUsuario[]
  objetivo_detalle           String?
  nivel_actividad            NivelActividad
  tipo_antecedentes          TipoAntecedente[]
  observaciones_antecedentes String?
  observaciones_finales      String?
  dias_disponibles           DiaSemana[]
  rutina                     Rutina?
  activo                     Boolean           @default(true)
  fecha_creacion             DateTime          @default(now())

  usuario            Usuario            @relation("ValoracionUsuario", fields: [id_usuario], references: [id_usuario])
  creador            Usuario            @relation("ValoracionCreador", fields: [id_creador], references: [id_usuario])
  datos_medicos      DatosMedicos?
  medidas_corporales MedidasCorporales?
}

model DatosMedicos {
  id_datos             String @id @default(uuid())
  id_valoracion        String @unique
  presion_arterial     String
  edad_metabolica      Float
  agua_corporal        Float
  resistencia_muscular Float

  valoracion Valoracion @relation(fields: [id_valoracion], references: [id_valoracion])
}

model MedidasCorporales {
  id_medidas     String @id @default(uuid())
  id_valoracion  String @unique
  peso           Float
  estatura       Float
  imc            Float
  grasa_corporal Float
  masa_muscular  Float
  masa_magra     Float
  grasa_visceral Float

  valoracion Valoracion @relation(fields: [id_valoracion], references: [id_valoracion])
}

// GIMNASIO: EJERCICIOS Y MÁQUINAS

model Ejercicio {
  id_ejercicio       String           @id @default(uuid())
  id_creador         String
  nombre             String
  descripcion        String?
  grupos_musculares  GrupoMuscular[]
  nivel              NivelExperiencia @default(principiante)
  url_multimedia     String?
  activo             Boolean          @default(true)
  fecha_creacion     DateTime         @default(now())
  fecha_modificacion DateTime         @updatedAt

  creador           Usuario            @relation(fields: [id_creador], references: [id_usuario])
  maquinas          MaquinaEjercicio[]
  rutina_ejercicios RutinaEjercicio[]
}

model Maquina {
  id_maquina         String           @id @default(uuid())
  id_creador         String
  nombre             String
  descripcion        String?
  grupos_musculares  GrupoMuscular[]
  nivel              NivelExperiencia @default(principiante)
  url_multimedia     String?
  estado             EstadoMaquina    @default(disponible)
  fecha_creacion     DateTime         @default(now())
  fecha_modificacion DateTime         @updatedAt

  creador    Usuario            @relation(fields: [id_creador], references: [id_usuario])
  ejercicios MaquinaEjercicio[]
}

model MaquinaEjercicio {
  id_maquina   String
  id_ejercicio String

  maquina   Maquina   @relation(fields: [id_maquina], references: [id_maquina])
  ejercicio Ejercicio @relation(fields: [id_ejercicio], references: [id_ejercicio])

  @@id([id_maquina, id_ejercicio])
}

// RUTINAS

model Rutina {
  id_rutina          String           @id @default(uuid())
  id_usuario         String
  id_creador         String
  id_valoracion      String?          @unique
  nombre             String
  duracion           RutinaDuracion?
  nivel              NivelExperiencia @default(principiante)
  estado             EstadoRutina     @default(activa)
  observaciones      String?
  fecha_creacion     DateTime         @default(now())
  fecha_modificacion DateTime         @updatedAt

  usuario    Usuario           @relation("RutinaUsuario", fields: [id_usuario], references: [id_usuario])
  creador    Usuario           @relation("RutinaCreador", fields: [id_creador], references: [id_usuario])
  valoracion Valoracion?       @relation(fields: [id_valoracion], references: [id_valoracion])
  ejercicios RutinaEjercicio[]
  sesiones   SesionRutina[]
}

model RutinaEjercicio {
  id_rutina_ejercicio String    @id @default(uuid())
  id_rutina           String
  id_ejercicio        String
  dia_semana          DiaSemana
  series              Int?
  repeticiones_min    Int?
  repeticiones_max    Int?
  descanso            Int? //segundos
  orden               Int
  observaciones       String?

  rutina    Rutina    @relation(fields: [id_rutina], references: [id_rutina])
  ejercicio Ejercicio @relation(fields: [id_ejercicio], references: [id_ejercicio])

  @@unique([id_rutina, dia_semana, orden])
}

model SesionRutina {
  id_sesion      String             @id @default(uuid())
  id_rutina      String
  fecha          DateTime
  hora_inicio    DateTime
  hora_fin       DateTime?
  estado         EstadoSesionRutina @default(en_progreso)
  fecha_creacion DateTime           @default(now())

  rutina Rutina @relation(fields: [id_rutina], references: [id_rutina])
}

// AGENDA

model Agenda {
  id_agenda          String       @id @default(uuid())
  id_usuario         String
  id_creador         String
  id_cupo            String?      @unique
  fecha              DateTime     @db.Date
  hora_inicio        DateTime     @db.Time
  hora_fin           DateTime?    @db.Time
  tipo               TipoAgenda
  tipo_otro          String?
  estado             EstadoAgenda @default(pendiente)
  observaciones      String?
  fecha_creacion     DateTime     @default(now())
  fecha_modificacion DateTime     @updatedAt

  usuario Usuario @relation("AgendaUsuario", fields: [id_usuario], references: [id_usuario])
  creador Usuario @relation("AgendaCreador", fields: [id_creador], references: [id_usuario])
  cupo    Cupo?   @relation(fields: [id_cupo], references: [id_cupo])
}

model Cupo {
  id_cupo        String   @id @default(uuid())
  id_creador     String
  fecha          DateTime @db.Date
  hora_inicio    DateTime @db.Time
  hora_fin       DateTime @db.Time
  fecha_creacion DateTime @default(now())

  creador Usuario @relation(fields: [id_creador], references: [id_usuario])
  agenda  Agenda?
}

// DOCUMENTOS

model DocumentoLegal {
  id_doc_legal       String          @id @default(uuid())
  nombre             String
  tipo               TipoDocLegal
  version            String?
  url_pdf            String?
  estado             EstadoDocumento @default(vigente)
  fecha_creacion     DateTime        @default(now())
  fecha_modificacion DateTime        @updatedAt

  aceptaciones AceptacionDocumento[]
}

model AceptacionDocumento {
  id_aceptacion    String   @id @default(uuid())
  id_doc_legal     String
  id_usuario       String
  id_activador     String?
  fecha_aceptacion DateTime @default(now())

  documento DocumentoLegal @relation(fields: [id_doc_legal], references: [id_doc_legal])
  usuario   Usuario        @relation("AceptacionUsuario", fields: [id_usuario], references: [id_usuario])
  activador Usuario?       @relation("AceptacionActivador", fields: [id_activador], references: [id_usuario])

  @@unique([id_doc_legal, id_usuario])
}
