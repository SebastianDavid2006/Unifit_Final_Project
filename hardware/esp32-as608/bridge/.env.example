# Copia este archivo a .env (cp .env.example .env) y ajusta los valores.
# Puerto serial del ESP32. Vacío = autodetección (CH340 / CP210x / Espressif).
PUERTO_SERIAL=
BAUD_RATE=115200
BACKEND_URL=http://localhost:3000/api
# Debe ser IDÉNTICA a BIOMETRIA_API_KEY del backend (.env raíz).
BIOMETRIA_API_KEY=tu_api_key_biometria_aqui
INTERVALO_POLL_MS=5000
TIMEOUT_DETECCION_MS=4000
INTERVALO_VERIFY_MS=1000
COOLDOWN_VERIFY_MS=5000
TIMEOUT_VERIFY_MS=13000
